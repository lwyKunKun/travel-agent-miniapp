
# LLM配置 (LangChain ChatOpenAI, 兼容任意OpenAI格式端点)
# 也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 命名
# 模型名称 (OpenAI: gpt-4o/gpt-4o-mini, DeepSeek: deepseek-chat, 通义: qwen-plus ...)
LLM_MODEL_ID=

# API密钥
LLM_API_KEY=

# 服务地址 (OpenAI官方端点留空即可; DeepSeek填 https://api.deepseek.com/v1)
LLM_BASE_URL=

# 温度 (可选, 默认0.7)
LLM_TEMPERATURE=0.7

# 超时时间 (可选, 默认60秒)
LLM_TIMEOUT=60.0

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# 高德地图API配置
AMAP_API_KEY=

# RAG 知识库配置 (千问 text-embedding-v4, 阿里云百炼 DashScope)
# 去 bailian.console.aliyun.com 免费开通获取; 留空则 RAG 自动禁用, 不影响主流程
DASHSCOPE_API_KEY=

# 嵌入模型名 (可选, 默认 text-embedding-v4)
EMBEDDING_MODEL=text-embedding-v4

# 微信小程序登录配置
# 小程序后台 (mp.weixin.qq.com) → 开发管理 → 开发设置 中获取
# 留空则进入 mock 登录模式 (本地开发联调用, 不调微信接口)
WX_APPID=
WX_SECRET=

# JWT 配置
# 签名密钥 (生产环境必须配置一个随机长字符串, 如: openssl rand -hex 32)
# 留空则每次启动生成随机密钥, 进程重启后旧 token 全部失效
JWT_SECRET=
# token 有效期(分钟), 默认 7 天
JWT_EXPIRE_MINUTES=10080
